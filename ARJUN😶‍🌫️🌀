          <span>For educational and paper-trading practice only. Always confirm market structure and manage risk carefully.</span>
        </div>
      </section>
    </div>
  </main>

  <!-- Optional Gemini API Key Modal -->
  <div id="keyModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-surface border border-lineSoft rounded-2xl max-w-md w-full p-5 shadow-2xl">
