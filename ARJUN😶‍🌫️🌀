        <div id="dropArea" tabindex="0" role="button" aria-label="Drop or paste raw candlestick chart screenshot" class="group relative cursor-pointer rounded-2xl border-2 border-dashed border-zinc-700 hover:border-emerald-400/80 focus:border-emerald-400 focus:outline-none bg-voidBlack min-h-[245px] sm:min-h-[290px] flex flex-col items-center justify-center p-4 text-center transition">
