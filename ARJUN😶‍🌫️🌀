<body class="bg-voidBlack text-slate-100 min-h-screen flex flex-col selection:bg-emerald-500/30 selection:text-emerald-200">
  <!-- Top Header -->
  <header class="sticky top-0 z-30 bg-voidBlack/95 backdrop-blur-md border-b border-lineSoft">
