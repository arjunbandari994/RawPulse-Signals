      <div class="flex items-center gap-2">
        <button id="openKeyModalBtn" type="button" class="px-3 py-2 rounded-xl bg-cardBg hover:bg-zinc-800 border border-lineSoft text-xs font-semibold text-slate-200 flex items-center gap-1.5 transition cursor-pointer">
