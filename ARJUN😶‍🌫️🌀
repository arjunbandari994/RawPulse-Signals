              </div>
              <div class="bg-cardBg border border-emerald-500/35 rounded-xl p-3">
                <span class="text-[11px] font-bold text-emerald-400 block">TP 4</span>
                <span id="tp4Val" class="text-xs sm:text-sm font-extrabold text-emerald-200 mt-0.5 block break-words">—</span>
