            <i class="fa-solid fa-folder-open text-emerald-400"></i>
            <span>Choose Screenshot</span>
          </label>
          <button id="sampleBullBtn" type="button" class="w-full py-2.5 px-3 rounded-xl bg-emerald-950/40 hover:bg-emerald-900/40 border border-emerald-500/40 text-xs font-bold text-emerald-200 flex items-center justify-center gap-1.5 transition cursor-pointer">
